// Cloudflare Workers: sitio estático (carpeta out/ de `next build`), sin código de servidor.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cirugiamerida",
  "compatibility_date": "2026-11-03",
  "assets": {
    "directory": "./out",
    // /hernias-merida → /hernias-merida/ (las páginas son carpetas con index.html, por trailingSlash: true)
    "html_handling": "auto-trailing-slash",
    // Rutas que no existen: out/404.html con estado 404
    "not_found_handling": "404-page"
  },
  // Mientras cirugiamerida.com no esté activo en Cloudflare, el sitio se publica en cirugiamerida.<cuenta>.workers.dev.
  // Cuando la zona aparezca "Active" (nameservers de Akky ya en Cloudflare), agregar los dominios aquí; el deploy crea
  // sus registros DNS y certificados (cirugiamerida.com es el principal; www redirige a él con una regla de Cloudflare):
  //   "routes": [
  //     { "pattern": "cirugiamerida.com", "custom_domain": true },
  //     { "pattern": "www.cirugiamerida.com", "custom_domain": true }
  //   ],
  "workers_dev": true,
  "observability": { "enabled": true },
  // Ramas que no son main (PR): Cloudflare las publica como vista previa con `wrangler preview`, que exige este bloque.
  // Repite la configuración de arriba que deba valer también en las vistas previas.
  "previews": {
    "observability": { "enabled": true }
  }
}
