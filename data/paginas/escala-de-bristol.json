, "h": 236, "src": "/img/bristol-6.webp", "alt": "Escala de Bristol, tipo 6: fragmentos pastosos o blandos con bordes irregulares", "fit": "cover", "rad": "0px", "id": 32, "padre": 1}, {"k": "caja", "x": 215, "y": 1795, "w": 176, "h": 236, "bg": "rgb(23, 59, 74)", "bimg": "", "rad": "0px", "borde": "", "id": 33, "padre": 1}, {"k": "texto", "x": 245, "y": 1818, "w": 124, "h": 50, "html": "<h2 style=\"--f:34;color:rgb(255, 255, 255);font-weight:600\">Tipo 7</h2>", "fs": 34, "color": "rgb(160, 121, 109)", "align": "start", "id": 34, "padre": 33}, {"k": "linea", "x": 249, "y": 1873, "w": 108, "h": 7, "color": "rgb(0, 0, 0)", "id": 35, "padre": 33}, {"k": "texto", "x": 226, "y": 1895, "w": 154, "h": 66, "html": "<p style=\"--f:18;color:rgb(255, 255, 255)\">Líquidas, sin fragmentos sólidos</p>", "fs": 18, "color": "rgb(160, 121, 109)", "align": "start", "id": 36, "padre": 33}, {"k": "img", "x": 392, "y": 1794, "w": 407, "h": 236, "src": "/img/bristol-7.webp", "alt": "Escala de Bristol, tipo 7: líquidas, sin fragmentos sólidos", "fit": "cover", "rad": "0px", "id": 37, "padre": 1}, {"k": "caja", "x": 985, "y": 60, "w": 359, "h": 2014, "bg": "rgb(255, 255, 255)", "bimg": "", "rad": "0px", "borde": "", "id": 38, "padre": 0}, {"k": "texto", "x": 241, "y": 2179, "w": 1114, "h": 184, "html": "<ul><li style=\"--f:18;color:rgb(82, 79, 79)\"><strong>Tipos 1 y 2:</strong> Sugieren estreñimiento.</li><li style=\"--f:18;color:rgb(82, 79, 79)\"><strong>Tipos 3 y 4:</strong> Generalmente representan heces formadas; el tipo 4 suele considerarse el patrón ideal.</li><li style=\"--f:18;color:rgb(82, 79, 79)\"><strong>Tipo 5:</strong> Heces blandas, cuya interpretación depende de la frecuencia y del contexto.</li><li style=\"--f:18;color:rgb(82, 79, 79)\"><strong>Tipos 6 y 7:</strong> Heces diarreicas.</li></ul>", "fs": 18, "color": "rgb(82, 79, 79)", "align": "start", "id": 39, "padre": null}, {"k": "texto", "x": 263, "y": 2386, "w": 870, "h": 29, "html": "<p style=\"--f:18;color:rgb(82, 79, 79)\">La escala describe la consistencia y forma, pero por sí sola no diagnostica una enfermedad.</p>", "fs": 18, "color": "rgb(82, 79, 79)", "align": "start", "id": 40, "padre": null}, {"k": "linea", "x": 263, "y": 2421, "w": 783, "h": 7, "color": "rgb(160, 121, 109)", "id": 41, "padre": null}, {"k": "btn", "x": 263, "y": 2459, "w": 258, "h": 36, "t": "¿Tienes diarrea o estreñimiento?", "href": "/diarrea-y-estrenimiento-merida/", "id": 42, "padre": null}, {"k": "btn", "x": 597, "y": 2459, "w": 258, "h": 36, "t": "¿Qué alimentos me convienen?", "href": "/dietas-especiales/", "id": 43, "padre": null}, {"k": "btn", "x": 918, "y": 2459, "w": 258, "h": 36, "t": "¿Cambios en las evacuaciones?", "href": "/intestino-irritable-merida/", "id": 44, "padre": null}]}, {"h": 513, "bg": "rgb(250, 250, 250)", "bgImg": "", "items": [{"k": "texto", "x": 230, "y": 38, "w": 980, "h": 82, "html": "<h2 style=\"--f:56;line-height:1.23;color:rgb(22, 59, 74);text-align:center\">Agenda una cita de valoración</h2>", "fs": 56, "color": "rgb(160, 121, 109)", "align": "center", "id": 0, "padre": null}, {"k": "texto", "x": 405, "y": 153, "w": 629, "h": 218, "html": "<p style=\"--f:18;color:rgb(82, 79, 79);text-align:center\">¿Tienes dolor abdominal, inflamación, gases, diarrea o estreñimiento que aparecen constantemente?</p><p class=\"vacio\" style=\"--f:18;color:rgb(82, 79, 79);text-align:center\"></p><p style=\"--f:18;color:rgb(82, 79, 79);text-align:center\">No tienes que acostumbrarte a vivir con molestias digestivas.</p><p class=\"vacio\" style=\"--f:18;color:rgb(82, 79, 79);text-align:center\"></p><p style=\"--f:18;color:rgb(82, 79, 79);text-align:center\">Una valoración médica puede ayudarte a identificar su causa, descartar otras enfermedades y encontrar alternativas para mejorar tu calidad de vida.</p>", "fs": 18, "color": "rgb(82, 79, 79)", "align": "center", "id": 1, "padre": null}, {"k": "btn", "x": 533, "y": 380, "w": 374, "h": 133, "t": "Agenda tu cita hoy", "href": "https://wa.me/529999566388", "tipo": "cita", "id": 2, "padre": null}]}]}