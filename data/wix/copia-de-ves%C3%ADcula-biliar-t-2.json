    {
     "k": "texto",
     "x": 420,
     "y": 136,
     "w": 600,
     "h": 258,
     "html": "<h3 data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">Es uno de los quistes más comunes.<br>\n&nbsp;<br>\nGeneralmente aparece como una bolita redonda debajo de la piel y puede encontrarse en:</h3>\n\n<ul>\n<li data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">\n<h3 data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">Cuero cabelludo.</h3>\n</li>\n<li data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">\n<h3 data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">Cara.</h3>\n</li>\n<li data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">\n<h3 data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">Cuello.</h3>\n</li>\n<li data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">\n<h3 data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">Espalda.</h3>\n</li>\n<li data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">\n<h3 data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">Tronco.</h3>\n</li>\n</ul>\n\n<h3 data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\"><br>\nAlgunas veces puede inflamarse o infectarse.</h3>",
     "fs": 18,
     "lh": "21.6px",
