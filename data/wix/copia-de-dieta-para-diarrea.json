     "html": "<ul>\n<li data-f=\"18\" data-c=\"rgb(22, 59, 74)\" data-a=\"start\">\n<h2 data-f=\"18\" data-c=\"rgb(22, 59, 74)\" data-a=\"start\">Preperaciones recomendadas:</h2>\n</li>\n<li data-f=\"18\" data-c=\"rgb(22, 59, 74)\" data-a=\"start\">\n<h2 data-f=\"18\" data-c=\"rgb(22, 59, 74)\" data-a=\"start\">Horneadas</h2>\n</li>\n<li data-f=\"18\" data-c=\"rgb(22, 59, 74)\" data-a=\"start\">\n<h2 data-f=\"18\" data-c=\"rgb(22, 59, 74)\" data-a=\"start\">Hervidas</h2>\n</li>\n<li data-f=\"18\" data-c=\"rgb(22, 59, 74)\" data-a=\"start\">\n<h2 data-f=\"18\" data-c=\"rgb(22, 59, 74)\" data-a=\"start\">Caldosas desgrasadas</h2>\n</li>\n<li data-f=\"18\" data-c=\"rgb(22, 59, 74)\" data-a=\"start\">\n<h2 data-f=\"18\" data-c=\"rgb(22, 59, 74)\" data-a=\"start\">A la plancha</h2>\n</li>\n</ul>",
