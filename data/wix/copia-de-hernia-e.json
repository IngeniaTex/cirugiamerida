     "w": 596,
     "h": 69,
     "html": "<h2 data-f=\"56\" data-c=\"rgb(23, 59, 74)\" data-a=\"start\">Síntomas frecuentes</h2>",
     "fs": 56,
     "lh": "normal",
     "color": "rgb(23, 59, 74)",
