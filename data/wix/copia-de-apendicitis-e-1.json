  {
   "top": 1178,
   "h": 465,
   "w": 1440,
   "bg": "rgb(255, 255, 255)",
   "bgImg": "",
   "items": [
    {
     "k": "texto",
     "x": 230,
     "y": 42,
     "w": 980,
     "h": 69,
     "html": "<h2 data-f=\"56\" data-c=\"rgb(23, 59, 74)\" data-a=\"center\">¿Qué es la cirugía laparoscópica?</h2>",
     "fs": 56,
     "lh": "normal",
     "color": "rgb(23, 59, 74)",
     "align": "center",
     "fw": "400",
     "ls": "normal"
    },
    {
     "k": "texto",
     "x": 405,
     "y": 155,
     "w": 629,
     "h": 245,
     "html": "<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">La cirugía laparoscópica es una técnica de mínima invasión que permite realizar procedimientos quirúrgicos a través de pequeñas incisiones.</p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\"></p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">Durante la cirugía se utiliza una cámara que transmite imágenes de alta definición a un monitor, permitiendo al cirujano visualizar el interior del abdomen con gran precisión.</p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\"></p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">Los instrumentos especializados se introducen a través de pequeñas incisiones para realizar el procedimiento de forma segura.</p>",
     "fs": 18,
     "lh": "25.2px",
     "color": "rgb(82, 79, 79)",
     "align": "start",
     "fw": "400",
     "ls": "normal"
    }
   ]
  },
