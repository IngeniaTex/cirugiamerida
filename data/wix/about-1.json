     "w": 596,
     "h": 207,
     "html": "<h2 data-f=\"56\" data-c=\"rgb(23, 59, 74)\" data-a=\"start\">¿Cuáles son los síntomas de las piedras en la vesícula?</h2>",
     "fs": 56,
     "lh": "normal",
     "color": "rgb(23, 59, 74)",
     "align": "start",
     "fw": "400",
     "ls": "normal"
    },
    {
     "k": "linea",
     "x": 665,
     "y": 289,
     "w": 60,
     "h": 5,
     "color": "rgb(160, 121, 109)"
    },
    {
     "k": "texto",
     "x": 665,
     "y": 315,
     "w": 490,
     "h": 404,
     "html": "<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"justify\">Los síntomas más frecuentes incluyen:</p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"justify\"></p>\n\n<ul>\n<li data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"justify\">\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"justify\">Dolor en la parte superior derecha del abdomen.</p>\n</li>\n<li data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"justify\">\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"justify\">Dolor después de comer alimentos grasosos.</p>\n</li>\n<li data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"justify\">\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"justify\">Sensación de pesadez después de las comidas.</p>\n</li>\n<li data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"justify\">\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"justify\">Náuseas.</p>\n</li>\n<li data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"justify\">\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"justify\">Vómito.</p>\n</li>\n<li data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"justify\">\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"justify\">Inflamación abdominal.</p>\n</li>\n<li data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"justify\">\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"justify\">Dolor que puede extenderse hacia la espalda o el hombro derecho</p>\n</li>\n</ul>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"justify\">&nbsp;</p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"justify\">Los síntomas suelen aparecer con mayor frecuencia después de comidas abundantes o con alto contenido de grasa.</p>",
     "fs": 18,
     "lh": "27px",
     "color": "rgb(82, 79, 79)",
     "align": "justify",
     "fw": "400",
     "ls": "normal"
    }
   ]
