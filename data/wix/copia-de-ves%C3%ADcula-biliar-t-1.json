     "h": 86,
     "html": "<h2 data-f=\"35\" data-c=\"rgb(49, 90, 107)\" data-a=\"start\">Tratamiento oportuno por Cirujano General Certificado y Especialista en Cirugía Laparoscópica</h2>",
     "fs": 35,
