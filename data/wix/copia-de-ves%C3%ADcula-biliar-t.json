  {
   "top": 826,
   "h": 542,
   "w": 1440,
   "bg": "rgb(233, 232, 227)",
   "bgImg": "",
   "items": [
    {
     "k": "texto",
     "x": 322,
     "y": 46,
     "w": 795,
     "h": 94,
     "html": "<h2 data-f=\"38\" data-c=\"rgb(49, 90, 107)\" data-a=\"center\">¿Cuándo se recomienda una operación de hernia?</h2>",
     "fs": 38,
     "lh": "normal",
     "color": "rgb(49, 90, 107)",
     "align": "center",
     "fw": "400",
     "ls": "normal"
    },
    {
     "k": "texto",
     "x": 322,
     "y": 182,
     "w": 795,
     "h": 299,
     "html": "<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">La cirugía suele recomendarse cuando:</p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\"></p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">· &nbsp; &nbsp;&nbsp; Existe una hernia diagnosticada.</p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">· &nbsp; &nbsp;&nbsp; La hernia ha aumentado de tamaño.</p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">· &nbsp; &nbsp;&nbsp; Produce dolor o molestias frecuentes.</p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">· &nbsp; &nbsp;&nbsp; Limita las actividades diarias.</p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">· &nbsp; &nbsp;&nbsp; Existe riesgo de complicaciones.</p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">· &nbsp; &nbsp;&nbsp; El paciente desea corregir el problema antes de que progrese.</p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\"></p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">Cada caso debe evaluarse de forma individual para determinar el mejor momento para realizar el procedimiento.</p>",
     "fs": 18,
     "lh": "25.2px",
     "color": "rgb(82, 79, 79)",
     "align": "start",
     "fw": "400",
     "ls": "normal"
    }
   ]
  },
