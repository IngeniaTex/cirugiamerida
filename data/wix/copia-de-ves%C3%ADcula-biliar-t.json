    {
     "k": "texto",
     "x": 258,
     "y": 101,
     "w": 907,
     "h": 98,
     "html": "<h2 data-f=\"40\" data-c=\"rgb(49, 90, 107)\" data-a=\"start\">por cirujano general Certificado y Especialista en Cirugía Laparoscópica</h2>",
     "fs": 40,
     "lh": "normal",
