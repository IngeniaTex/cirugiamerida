     "html": "<h2 data-f=\"56\" data-c=\"rgb(23, 59, 74)\" data-a=\"start\">¿Cómo se siente un lipoma?</h2>",
     "fs": 56,
     "lh": "normal",
     "color": "rgb(23, 59, 74)",
     "align": "start",
     "fw": "400",
     "ls": "normal"
    },
    {
     "k": "linea",
     "x": 665,
