     "html": "<h2 data-f=\"56\" data-c=\"rgb(49, 90, 107)\" data-a=\"start\">Recomendaciones generales de alimentación</h2>",
     "fs": 56,
     "lh": "normal",
     "color": "rgb(49, 90, 107)",
