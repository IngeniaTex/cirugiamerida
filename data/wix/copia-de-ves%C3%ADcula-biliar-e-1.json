     "h": 32,
     "html": "<p data-f=\"20\" data-c=\"rgb(23, 59, 74)\" data-a=\"start\">¿Tienes dolor en el lado derecho del abdomen?</p>",
     "fs": 20,
     "lh": "normal",
     "color": "rgb(23, 59, 74)",
