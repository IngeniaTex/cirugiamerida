     "h": 69,
     "html": "<h2 data-f=\"56\" data-c=\"rgb(23, 59, 74)\" data-a=\"center\">¿Cuándo debo acudir a urgencias?</h2>",
     "fs": 56,
     "lh": "normal",
     "color": "rgb(23, 59, 74)",
