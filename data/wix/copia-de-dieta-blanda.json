     "html": "<h2 data-f=\"33\" data-c=\"rgb(49, 90, 107)\" data-a=\"start\">La dieta tiene 3 etapas:</h2>",
     "fs": 33,
     "lh": "39.6px",
     "color": "rgb(49, 90, 107)",
