     "h": 131,
     "html": "<h2 data-f=\"33\" data-c=\"rgb(255, 255, 255)\" data-a=\"start\">Recomendaciones prácticas</h2>",
     "fs": 33,
     "lh": "39.6px",
     "color": "rgb(255, 255, 255)",
     "align": "start",
     "fw": "400",
     "ls": "normal"
    },
    {
     "k": "caja",
     "x": 576,
