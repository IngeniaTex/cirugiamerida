     "y": 51,
     "w": 879,
     "h": 32,
     "html": "<p data-f=\"26\" data-c=\"rgb(184, 155, 106)\" data-a=\"start\">Importante</p>",
     "fs": 26,
     "lh": "normal",
     "color": "rgb(184, 155, 106)",
     "align": "start",
     "fw": "400",
     "ls": "normal"
    },
    {
     "k": "linea",
