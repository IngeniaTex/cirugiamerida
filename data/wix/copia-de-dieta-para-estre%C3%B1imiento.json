     "borde": "",
     "sombra": 0
    },
    {
     "k": "texto",
     "x": 721,
     "y": 40,
     "w": 574,
     "h": 291,
     "html": "<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">Comer porciones pequeñas varias veces al día.</p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">&nbsp;</p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">Evitar automedicarse con antibióticos.</p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">&nbsp;</p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">Suspender temporalmente alimentos irritantes.</p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">&nbsp;</p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">Mantener adecuada hidratación.</p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">&nbsp;</p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">Reintroducir alimentos de forma gradual conforme mejoren los síntomas.</p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\"></p>",
     "fs": 18,
     "lh": "25.2px",
     "color": "rgb(82, 79, 79)",
     "align": "start",
     "fw": "400",
     "ls": "normal"
    }
   ]
  },
