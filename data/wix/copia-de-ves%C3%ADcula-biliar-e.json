    },
    {
     "k": "texto",
     "x": 405,
     "y": 108,
     "w": 629,
     "h": 299,
     "html": "<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">Debes buscar atención médica inmediata si presentas:</p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\"></p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">· &nbsp; &nbsp;&nbsp; Dolor intenso y repentino.</p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">· &nbsp; &nbsp;&nbsp; Una hernia que no desaparece al acostarte.</p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">· &nbsp; &nbsp;&nbsp; Náuseas o vómitos.</p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">· &nbsp; &nbsp;&nbsp; Inflamación importante.</p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">· &nbsp; &nbsp;&nbsp; Enrojecimiento de la piel sobre la hernia.</p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">· &nbsp; &nbsp;&nbsp; Fiebre.</p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\"></p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">Estos síntomas pueden indicar una complicación que requiere atención urgente.</p>",
     "fs": 18,
     "lh": "25.2px",
