     "w": 596,
     "h": 138,
     "html": "<h2 data-f=\"56\" data-c=\"rgb(23, 59, 74)\" data-a=\"start\">¿Cómo puedo saber si tengo una hernia?</h2>",
     "fs": 56,
     "lh": "normal",
