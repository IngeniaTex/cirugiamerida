     "y": 0,
     "w": 980,
     "h": 82,
     "html": "<h2 data-f=\"56\" data-c=\"rgb(49, 90, 107)\" data-a=\"center\">¿Cuándo debo acudir a urgencias?</h2>",
     "fs": 56,
     "lh": "78.4px",
