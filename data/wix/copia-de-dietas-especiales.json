     "w": 980,
     "h": 67,
     "html": "<h2 data-f=\"40\" data-c=\"rgb(22, 59, 74)\" data-a=\"center\">¿Tienes dudas sobre tu recuperación?</h2>",
     "fs": 40,
     "lh": "56px",
     "color": "rgb(160, 121, 109)",
     "align": "center",
     "fw": "400",
