    {
     "k": "texto",
     "x": 258,
     "y": 35,
     "w": 907,
     "h": 58,
     "html": "<h2 data-f=\"47\" data-c=\"rgb(49, 90, 107)\" data-a=\"start\">Heridas Quirúrgicas</h2>",
     "fs": 47,
     "lh": "normal",
     "color": "rgb(160, 121, 109)",
     "align": "start",
     "fw": "400",
     "ls": "normal"
    },
    {
     "k": "texto",
     "x": 258,
     "y": 131,
     "w": 430,
     "h": 136,
     "html": "<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">¿Qué es una herida quirúrgica?</p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\"></p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">Es la pérdida de la continuidad de la piel<br>\ncausada por un traumatismo o intervención<br>\nquirúrgica.</p>",
     "fs": 18,
     "lh": "25.2px",
     "color": "rgb(82, 79, 79)",
     "align": "start",
     "fw": "400",
     "ls": "normal"
    },
    {
