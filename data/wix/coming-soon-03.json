     "y": 35,
     "w": 907,
     "h": 58,
     "html": "<h2 data-f=\"47\" data-c=\"rgb(49, 90, 107)\" data-a=\"start\">Cirugía Laparoscópica</h2>",
     "fs": 47,
     "lh": "normal",
     "color": "rgb(160, 121, 109)",
