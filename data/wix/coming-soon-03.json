    {
     "k": "texto",
     "x": 473,
     "y": 154,
     "w": 494,
     "h": 207,
     "html": "<h1 data-f=\"56\" data-c=\"rgb(49, 90, 107)\" data-a=\"center\">¿Cuándo se recomienda la cirugía?</h1>",
     "fs": 56,
     "lh": "normal",
     "color": "rgb(49, 90, 107)",
     "align": "center",
     "fw": "400",
     "ls": "normal"
    },
    {
     "k": "texto",
     "x": 473,
     "y": 381,
     "w": 494,
     "h": 272,
     "html": "<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"justify\">Generalmente se recomienda cuando existen:</p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"justify\"></p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"justify\">· &nbsp; &nbsp;&nbsp; Dolor relacionado con piedras en la vesícula.</p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"justify\">· &nbsp; &nbsp;&nbsp; Episodios repetidos de inflamación.</p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"justify\">· &nbsp; &nbsp;&nbsp; Náuseas o vómitos frecuentes después de comer.</p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"justify\">· &nbsp; &nbsp;&nbsp; Complicaciones derivadas de las piedras.</p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"justify\">· &nbsp; &nbsp;&nbsp; Riesgo elevado de nuevos episodios.</p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"justify\"></p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"justify\">Cada paciente debe ser evaluado de forma individual para determinar si la cirugía es la mejor alternativa.</p>",
     "fs": 18,
     "lh": "25.2px",
     "color": "rgb(82, 79, 79)",
     "align": "justify",
     "fw": "400",
     "ls": "normal"
    },
