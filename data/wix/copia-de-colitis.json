     "h": 69,
     "html": "<h2 data-f=\"56\" data-c=\"rgb(23, 59, 74)\" data-a=\"center\">¿Qué es la diarrea?</h2>",
     "fs": 56,
     "lh": "normal",
     "color": "rgb(23, 59, 74)",
     "align": "center",
     "fw": "400",
     "ls": "normal"
    },
    {
     "k": "texto",
     "x": 405,
     "y": 155,
     "w": 629,
     "h": 136,
     "html": "<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">La diarrea se caracteriza por evacuaciones más frecuentes de lo habitual y con consistencia líquida o semilíquida.</p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\"></p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">Puede presentarse de manera aguda durante algunos días o persistir durante periodos más prolongados.</p>",
     "fs": 18,
     "lh": "25.2px",
     "color": "rgb(82, 79, 79)",
     "align": "start",
     "fw": "400",
     "ls": "normal"
    }
   ]
