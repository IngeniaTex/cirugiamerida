     "w": 541,
     "h": 69,
     "html": "<h2 data-f=\"56\" data-c=\"rgb(49, 90, 107)\" data-a=\"start\">Colitis en Mérida</h2>",
     "fs": 56,
     "lh": "normal",
     "color": "rgb(49, 90, 107)",
