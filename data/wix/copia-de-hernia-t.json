    {
     "k": "texto",
     "x": 769,
     "y": 96,
     "w": 513,
     "h": 163,
     "html": "<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">El objetivo de la cirugía es disminuir el reflujo y restaurar el mecanismo natural que evita que el contenido del estómago regrese hacia el esófago.</p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\"></p>\n\n<p data-f=\"18\" data-c=\"rgb(82, 79, 79)\" data-a=\"start\">Cuando existe hernia hiatal, ésta también puede corregirse durante el mismo procedimiento.</p>",
     "fs": 18,
     "lh": "25.2px",
     "color": "rgb(82, 79, 79)",
     "align": "start",
     "fw": "400",
     "ls": "normal"
    }
   ]
